{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ferrum.dev/beacon/schemas/pathogen-extension.json",
  "title": "Ferrum Beacon v2 pathogen meta-schema extension",
  "description": "Multi-organism pathogen surveillance fields for African field-lab Beacon datasets.",
  "type": "object",
  "properties": {
    "pathogens": {
      "type": "object",
      "properties": {
        "organism": {
          "type": "string",
          "description": "NCBI taxonomy ID or free text organism name"
        },
        "amr_genes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "serotype": { "type": "string" },
        "virulence_factors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ont_qscore_min": { "type": "number" }
      },
      "required": ["organism"]
    }
  }
}
