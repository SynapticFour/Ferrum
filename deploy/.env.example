# Ferrum local demo – copy to .env and adjust as needed.
# Usage: cp deploy/.env.example .env && docker compose -f deploy/docker-compose.yml up -d
#
# Cross-repo pins: see VERSIONS.lock at repo root (GA4GH_INFRA_REF, HELIXTEST_REF).

# --- Release version (required for ./install.sh — no silent :latest) ---
FERRUM_VERSION=v0.2.0

# --- Cross-repo version pins (defaults match VERSIONS.lock) ---
# GA4GH_INFRA_REF=ga4gh-infra-v0.2.3

# --- PostgreSQL ---
POSTGRES_USER=ferrum
POSTGRES_PASSWORD=ferrum
POSTGRES_DB=ferrum

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ferrum

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=ferrum
# JWKS URL for Ferrum gateway (after Keycloak is up). For local: use host port if gateway is behind nginx.
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/ferrum/protocol/openid-connect/certs

# --- Published ports ---
GATEWAY_PORT=8080
UI_PORT=8082

# --- Optional: Ferrum config overrides (env vars take precedence over config.toml) ---
# FERRUM_BIND=0.0.0.0:8080
# FERRUM_DATABASE__URL=postgres://ferrum:ferrum@postgres:5432/ferrum
# FERRUM_DATABASE__RUN_MIGRATIONS=true
# FERRUM_STORAGE__BACKEND=s3
# FERRUM_STORAGE__S3_ENDPOINT=http://minio:9000
# FERRUM_STORAGE__S3_REGION=us-east-1
# FERRUM_STORAGE__S3_BUCKET=ferrum
# FERRUM_STORAGE__S3_ACCESS_KEY_ID=minioadmin
# FERRUM_STORAGE__S3_SECRET_ACCESS_KEY=minioadmin
# FERRUM_AUTH__JWKS_URL=http://keycloak:8080/realms/ferrum/protocol/openid-connect/certs
# FERRUM_AUTH__REQUIRE_AUTH=false

# --- Demo HelixTest stubs (NON-PILOT only; leave unset/false for pilots) ---
# FERRUM_TES_HELIXTEST_STUB=true
# FERRUM_WES_HELIXTEST_STUBS=true

# --- TES Docker volume allowlist (required for client/WES request volumes) ---
# FERRUM_TES_ALLOWED_BIND_PREFIXES=/data/tes
# FERRUM_AUTH__AUDIENCE=ferrum

# --- Optional: WES → TRS auto-register (default on; set false to disable) ---
# FERRUM_WES_TRS_AUTO_REGISTER=true
# FERRUM_WES_TRS_REGISTER_URL=http://127.0.0.1:8080/ga4gh/trs/v2

# --- Optional: WES → TES (nested Docker / GA4GH-style demos; all off by default) ---
# See docs/TES-DOCKER-BACKEND.md
# FERRUM_WES_TES_WORK_HOST_PREFIX=.wes-runs
# (default when unset: deploy/.wes-runs — relative to deploy/docker-compose.tes.yml)
# FERRUM_WES_TES_CONTAINER_WORKDIR=/data/wes-runs
# FERRUM_WES_TES_WDL_BASH_LAUNCH=1
# FERRUM_WES_TES_NEXTFLOW_FILE_LAUNCH=1

# --- Optional: TES Docker executor (only when gateway built with --features tes-docker) ---
# FERRUM_TES_DOCKER_PLATFORM=linux/amd64
# FERRUM_TES_DOCKER_EXTRA_HOSTS=host.docker.internal:host-gateway
# FERRUM_TES_DOCKER_MOUNT_SOCKET=1
# FERRUM_WES_GATEWAY_INTERNAL_URL=http://host.docker.internal:8080
# FERRUM_WES_TES_IMAGE_CWL=quay.io/commonwl/cwltool:3.2.20260413085819
# FERRUM_WES_TES_IMAGE_NEXTFLOW=nextflow/nextflow:24.10.3
# FERRUM_WES_TES_IMAGE_WDL=broadinstitute/cromwell:93-0232cbd
# FERRUM_WES_TES_IMAGE_SNAKEMAKE=snakemake/snakemake:v7.32.4
# FERRUM_TES_DOCKER_CLI_HOST_PATH=/usr/bin/docker
# FERRUM_TES_DOCKER_NETWORK_MODE=host
# FERRUM_TES_DOCKER_EXTRA_HOSTS=host.docker.internal:host-gateway
# FERRUM_TES_DOCKER_PLATFORM=linux/amd64

# make up-pilot — local Ferrum + Fly ga4gh-infra / Keycloak AAI (default laptop pilot)
# PILOT_CLOUD_GA4GH_URL=https://pasteur-pilot-ga4gh-infra.fly.dev
# PILOT_CLOUD_AUTO_REGISTER=true
# SERVICE_REGISTRY_REGISTRATION_KEY=...  # same as Fly ga4gh-infra secret (for local auto-register)

# make up-pilot-local — full offline ga4gh stack (mock-idp); no Fly required

# Service discovery (default on for make up / make up-tes; resolves TES/TRS via local gateway paths)
# FERRUM_DISCOVERY__ENABLED=true
# FERRUM_DISCOVERY__REGISTRATION_BASE_URL=http://localhost:8080
# When multiple registry entries share an artifact, prefer this exact GA4GH service id:
# FERRUM_DISCOVERY__PREFERRED_SERVICE_ID=org.synapticfour.ferrum.tes
# FERRUM_DISCOVERY__PREFERRED_ENVIRONMENT=production
# FERRUM_DISCOVERY__PREFERRED_ORGANIZATION=Ferrum

# --- UI: pilot problem reports (mailto + GitHub issue prefill) ---
# VITE_ENABLE_PROBLEM_REPORT=true
# VITE_PROBLEM_REPORT_EMAIL=contact@synapticfour.com
# VITE_PROBLEM_REPORT_GITHUB_REPO=SynapticFour/Ferrum
