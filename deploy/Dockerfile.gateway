# Build Ferrum gateway binary
# Override in CI via build-args to use a mirror when Docker Hub is flaky, e.g.:
#   RUST_BUILDER_IMAGE=public.ecr.aws/docker/library/rust:1.91.1-bookworm
#
# BuildKit: every ARG used in any FROM must be declared here *before* the first FROM
# (not only before the stage that uses it), or the runtime stage gets a blank image name.
ARG RUST_BUILDER_IMAGE=rust:1.91.1-bookworm
ARG DEBIAN_RUNTIME_IMAGE=debian:bookworm-slim
ARG FERRUM_GIT_SHA=unknown
ARG FERRUM_BUILD_PROFILE=demo
FROM ${RUST_BUILDER_IMAGE} AS builder
# Optional: e.g. `tes-docker` for Docker-backed TES (re-declare after FROM so RUN sees it).
ARG FERRUM_GATEWAY_FEATURES=
WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY tools ./tools
COPY third_party ./third_party
COPY deploy/scripts/clone-ga4gh-infra.sh /tmp/clone-ga4gh-infra.sh
ARG GA4GH_INFRA_REF=e43bf08bce5132db697a28c7db898d5e18f87b3f
RUN chmod +x /tmp/clone-ga4gh-infra.sh && GA4GH_INFRA_REF="${GA4GH_INFRA_REF}" /tmp/clone-ga4gh-infra.sh /ga4gh-infra

RUN if [ -n "$FERRUM_GATEWAY_FEATURES" ]; then \
      cargo build --release -p ferrum-gateway --features "$FERRUM_GATEWAY_FEATURES"; \
    else \
      cargo build --release -p ferrum-gateway; \
    fi

# Runtime image (keep in sync with builder OS family)
FROM ${DEBIAN_RUNTIME_IMAGE}
ARG FERRUM_GIT_SHA=unknown
ARG FERRUM_BUILD_PROFILE=demo
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=builder /app/target/release/ferrum-gateway /app/ferrum-gateway
RUN mkdir -p /app/data

ENV FERRUM_BIND=0.0.0.0:8080 \
    FERRUM_BUILD__GIT_SHA=${FERRUM_GIT_SHA} \
    FERRUM_BUILD__PROFILE=${FERRUM_BUILD_PROFILE}
EXPOSE 8080

CMD ["/app/ferrum-gateway"]
