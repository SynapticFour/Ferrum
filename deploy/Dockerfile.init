# Init container: migrations, MinIO bucket, Keycloak realm, Crypt4GH keys, seed DRS.
# Run once after postgres/minio/keycloak are healthy.
#
# keygen-builder MUST target musl: the runtime image is Alpine; a bookworm/glibc
# binary fails at runtime with exit 127 (command not found).
ARG RUST_BUILDER_IMAGE=rust:1.91.1-alpine
FROM ${RUST_BUILDER_IMAGE} AS keygen-builder
RUN apk add --no-cache musl-dev pkgconfig libsodium-dev git perl make bash
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY tools ./tools
COPY third_party ./third_party
COPY deploy/scripts/clone-ga4gh-infra.sh /tmp/clone-ga4gh-infra.sh
ARG GA4GH_INFRA_REF=ga4gh-infra-v0.2.2
RUN chmod +x /tmp/clone-ga4gh-infra.sh && GA4GH_INFRA_REF="${GA4GH_INFRA_REF}" /tmp/clone-ga4gh-infra.sh /ga4gh-infra
RUN cargo build --release -p ferrum-crypt4gh --bin ferrum-node-keygen

FROM alpine:3.19
RUN apk add --no-cache postgresql16-client curl netcat-openbsd bash wget libsodium

# MinIO client for bucket creation (multi-arch)
ARG TARGETARCH
RUN case "$TARGETARCH" in \
    amd64) MC_ARCH=amd64 ;; \
    arm64) MC_ARCH=arm64 ;; \
    *) MC_ARCH=amd64 ;; esac \
    && wget -q -O /usr/local/bin/mc "https://dl.min.io/client/mc/release/linux-${MC_ARCH}/mc" \
    && chmod +x /usr/local/bin/mc

COPY --from=keygen-builder /app/target/release/ferrum-node-keygen /usr/local/bin/ferrum-node-keygen
RUN chmod +x /usr/local/bin/ferrum-node-keygen \
    && mkdir -p /tmp/ferrum-keygen-smoke \
    && ferrum-node-keygen /tmp/ferrum-keygen-smoke \
    && test -f /tmp/ferrum-keygen-smoke/node.sec \
    && test -f /tmp/ferrum-keygen-smoke/node.pub \
    && rm -rf /tmp/ferrum-keygen-smoke

WORKDIR /app
COPY deploy/scripts/init-demo.sh /app/init-demo.sh
RUN chmod +x /app/init-demo.sh
RUN grep -q "test-object-1" /app/init-demo.sh && \
    grep -q "demo-bam-to-vcf" /app/init-demo.sh && \
    grep -q "microbench-plain-v1" /app/init-demo.sh

# Copy migrations (build context is repo root)
COPY crates/ferrum-core/migrations /migrations
# Ensure migration files include required DROP statements (fail build if stale)
RUN grep -q "DROP TABLE IF EXISTS wes_runs" /migrations/20250101000003_wes_schema.up.sql && \
    grep -q "DROP TABLE IF EXISTS tes_tasks" /migrations/20250101000004_tes_schema.up.sql && \
    grep -q "DROP TABLE IF EXISTS trs_tools" /migrations/20250101000005_trs_schema.up.sql
RUN ls -la /migrations

ENV CRYPT4GH_KEY_DIR=/data/ferrum/keys
VOLUME /data

ENTRYPOINT ["/app/init-demo.sh"]
