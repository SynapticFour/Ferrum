# Ferrum Helm — example overlay (maps to deploy/.env.example)
#
#   cp deploy/helm/values.yaml.example my-values.yaml
#   helm upgrade --install ferrum deploy/helm -f my-values.yaml
#
# Chart version = Ferrum release tag (no separate Helm cycle). Image tag v0.3.2.

replicaCount: 1

image:
  repository: ghcr.io/synapticfour/ferrum
  tag: "v0.3.2"
  pullPolicy: IfNotPresent

service:
  type: ClusterIP
  port: 8080

ingress:
  enabled: false
  className: nginx
  annotations: {}
  hosts:
    - host: ferrum.example.com
      paths:
        - path: /
          pathType: Prefix
  tls: []

existingSecret: ""

config:
  bind: "0.0.0.0:8080"
  database:
    url: "postgres://ferrum:CHANGE_ME@postgres.example.svc:5432/ferrum"
    run_migrations: true
  storage:
    backend: s3
    base_path: /data/objects
    s3_endpoint: "http://minio.example.svc:9000"
    s3_region: us-east-1
    s3_bucket: ferrum
    s3_access_key_id: CHANGE_ME
    s3_secret_access_key: CHANGE_ME
  auth:
    require_auth: true
    jwks_url: "http://keycloak.example.svc/realms/ferrum/protocol/openid-connect/certs"
  services:
    enable_drs: true
    enable_htsget: true
    enable_wes: true
    enable_tes: true
    enable_beacon: true
    enable_trs: true
  wesBackend: ""
  tesBackend: ""
  wesSlurmPartition: ""
  tesSlurmPartition: ""

resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: "1"
    memory: 1Gi
