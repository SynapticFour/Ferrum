# Ferrum Helm — example values (maps to deploy/.env.example)
#
#   cp deploy/helm/values.yaml.example my-values.yaml
#   helm upgrade --install ferrum deploy/helm -f my-values.yaml
#
# Chart version = Ferrum release tag (no separate Helm release cycle).

replicaCount: 1

# FERRUM_VERSION / image tag → match GitHub Release (e.g. v0.2.0)
image:
  repository: ferrum-gateway
  tag: v0.2.0
  pullPolicy: IfNotPresent

# GATEWAY_PORT
service:
  type: ClusterIP
  port: 8080

ingress:
  enabled: false
  className: nginx
  annotations: {}
  hosts:
    - host: ferrum.example.com
      paths:
        - path: /
          pathType: Prefix
  tls: []

# Optional: reference pre-created secret with FERRUM_DATABASE__URL, S3 keys, etc.
existingSecret: ""

config:
  bind: "0.0.0.0:8080"

  # POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB → FERRUM_DATABASE__URL
  database:
    url: "postgres://ferrum:CHANGE_ME@postgres.example.svc:5432/ferrum"
    run_migrations: true

  # MINIO_ROOT_* / MINIO_BUCKET → FERRUM_STORAGE__S3_*
  storage:
    backend: s3
    s3_endpoint: "http://minio.example.svc:9000"
    s3_region: us-east-1
    s3_bucket: ferrum
    s3_access_key_id: CHANGE_ME
    s3_secret_access_key: CHANGE_ME

  # KEYCLOAK_JWKS_URL → FERRUM_AUTH__JWKS_URL
  auth:
    require_auth: true
    jwks_url: "http://keycloak.example.svc/realms/ferrum/protocol/openid-connect/certs"

resources: {}
