# Example nginx config — TLS + Basic Auth in front of Ferrum demo stack.
#
# Replace ferrum-pilot.example.org, certificate paths, and htpasswd file.
# Generate htpasswd:  htpasswd -c /etc/nginx/ferrum-pilot.htpasswd pilot
#
# Upstream: demo stack nginx on 8082 (UI + API) or gateway-only on 8080.

upstream ferrum_demo {
    server 127.0.0.1:8082;
    keepalive 8;
}

# Optional IP allowlist (institute VPN / known egress)
# geo $allow_access {
#     default 0;
#     203.0.113.0/24 1;
#     198.51.100.0/24 1;
# }

server {
    listen 443 ssl http2;
    server_name ferrum-pilot.example.org;

    ssl_certificate     /etc/ssl/certs/ferrum-pilot.pem;
    ssl_certificate_key /etc/ssl/private/ferrum-pilot-key.pem;

    client_max_body_size 100M;

    # if ($allow_access = 0) { return 403; }

    location /health {
        auth_basic off;
        proxy_pass http://ferrum_demo;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_basic "Ferrum Pilot";
        auth_basic_user_file /etc/nginx/ferrum-pilot.htpasswd;
        proxy_pass http://ferrum_demo;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ferrum-pilot.example.org;
    return 301 https://$host$request_uri;
}
