# Local Ferrum + Fly Keycloak AAI (make up-pilot-cloud)
UI_PARITY_PROFILE=up-pilot-cloud
BASE_URL=${BASE_URL:-http://localhost:8080}
GA4GH_URL=${PILOT_CLOUD_GA4GH_URL:-https://pasteur-pilot-ga4gh-infra.fly.dev}
REQUIRE_AUTH=1
TES_BACKEND=noop
WES_REQUIRE_COMPLETE=0
WES_SUBMIT_WORKFLOW=/ga4gh/trs/v2/tools/demo-wdl-hello/versions/demo-wdl-hello-1.0/descriptor/WDL
WES_SUBMIT_TYPE=WDL
TRS_DESCRIPTOR_PATH=/ga4gh/trs/v2/tools/demo-wdl-hello/versions/demo-wdl-hello-1.0/descriptor/WDL
ADS_EXPECTED=1
DELEGATE_PILOT_CLOUD_E2E=0
